# FlowDeploy Environment Configuration
# Copy this file to .env and adjust values for your environment

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgres://paas_deploy:paas_deploy@localhost:5432/paas_deploy?sslmode=disable

# =============================================================================
# Backend API
# =============================================================================
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# =============================================================================
# Deploy Engine
# =============================================================================
# Directory where application repositories are cloned
DEPLOY_DATA_DIR=/data/apps

# Number of concurrent deploy workers
DEPLOY_WORKERS=2

# Default timeout for deploy operations (in seconds)
DEPLOY_TIMEOUT=600

# Health check timeout (in seconds)
HEALTH_CHECK_TIMEOUT=60

# Health check retry interval (in seconds)
HEALTH_CHECK_INTERVAL=5

# Health check retry attempts
HEALTH_CHECK_RETRIES=3

# =============================================================================
# Docker
# =============================================================================
DOCKER_HOST=unix:///var/run/docker.sock

# Docker registry for built images (optional)
# DOCKER_REGISTRY=registry.example.com

# =============================================================================
# Frontend
# =============================================================================
VITE_API_URL=http://localhost:8080
VITE_SSE_URL=http://localhost:8080/events/deploys

# =============================================================================
# Traefik (Production)
# =============================================================================
# Domain for the FlowDeploy dashboard
# TRAEFIK_DOMAIN=deploy.example.com

# =============================================================================
# GitHub (Future)
# =============================================================================
# GITHUB_WEBHOOK_SECRET=your-webhook-secret
# GITHUB_APP_ID=your-app-id
# GITHUB_PRIVATE_KEY_PATH=/path/to/private-key.pem

# =============================================================================
# MCP Server (apps/mcp; consumed by deploy/docker-compose.yml)
# =============================================================================
# Public hostname used by Traefik to expose /mcp over HTTPS (Let's Encrypt).
# Defaults to mcp.localhost in dev; override with the real DNS in production.
MCP_HOST=mcp.localhost

# Backend URL the MCP forwards tool calls to. Reuse the internal docker DNS
# name in production; in dev you can point this at http://localhost:8080.
FLOWDEPLOY_BACKEND_URL=http://backend:8080

# Logging verbosity for the MCP binary (debug|info|warn|error).
FLOWDEPLOY_MCP_LOG_LEVEL=info

# Comma-separated allowlist of X-MCP-Client values accepted by the HTTP
# transport. Wildcards use the form `prefix:*` (e.g. `ci:*` accepts ci:gh).
# Reject everything when empty.
FLOWDEPLOY_MCP_ALLOWED_CLIENTS=cursor,claude-desktop,custom:*,ci:*

# Per-PAT rate limits (rolling minute) for read and mutate operations. Reads
# include initialize/ping/tools.list/resources.read; mutates are write- or
# destructive-mode tool calls (apps_deploy, apps_delete, env_set, ...).
FLOWDEPLOY_MCP_READ_RPM=120
FLOWDEPLOY_MCP_MUTATE_RPM=20
